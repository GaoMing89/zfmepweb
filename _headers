/gf-water/*
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.open-meteo.com https://formsubmit.co; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; base-uri 'self'

/images/gf-water/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/gf-water/gf-water.css
  Cache-Control: public, max-age=31536000, immutable

/gf-water/
  Cache-Control: public, max-age=0, must-revalidate

/gf-water/index.html
  Cache-Control: public, max-age=0, must-revalidate
